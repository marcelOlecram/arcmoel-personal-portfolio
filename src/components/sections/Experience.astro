---
import Section from "@/components/Section.astro";

import { getCollection, getEntry } from 'astro:content';
const cv = await getEntry('cv', `${Astro.currentLocale}/cv`);
const work = cv?.data.work;

interface Props {
	title: string;
    highlight: string
}

const { title, highlight } = Astro.props;
---

<Section title={title} highlight={highlight} >
    <ul>
        {work?.map(
            ({name, position, url, startDate, endDate, summary, highlights}) => 
            {
                const startYear = new Date(startDate).getFullYear();
                const endYear = endDate != null? new Date(endDate).getFullYear() : "Present";
                const years = `${startYear} - ${endYear}`
                return (
                <li>
                    <article>
                        <header>
                            <div>
                                <h3>{name}</h3>
                                <p>{position}</p>
                            </div>
                            <time>{years}</time>
                        </header>
                        <footer>
                            <p>{summary}</p>
                            <h4>{highlight}</h4>
                            <ul class="highlights">
                            {
                                highlights?.map((item) => {
                                    return (<li>{item}</li>)
                                    
                                    
                                })
                            }
                            </ul>
                        </footer>
                    </article>                    
                </li>)
            }
        )
        
        }
    </ul>
</Section>

<style>
    ul{
        display: flex;
        flex-direction: column;
        gap: 20px 32px;
    }

    article h3 {
        font-weight: 400;
        font-size: 1.5rem;
        color: #111;
    }

    article h4 {
        font-weight: 600;
        font-size: 1.2rem;
        color: #111;
        margin-top: 0.2em;
        margin-bottom: 0.2em;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    time {
        font-size: 0.85rem;
        color: #555;
    }

    ul.highlights {
        list-style: disc;
        padding-left: 1.5em;
        font-size: 0.8em;
        gap: 0.4em;
        color: #333333;
    }
</style>